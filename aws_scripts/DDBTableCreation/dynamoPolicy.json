{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/yx-cam-data",
        "arn:aws:dynamodb:*:*:table/yx-cam-data/index/*"
      ]
    }
  ]
}