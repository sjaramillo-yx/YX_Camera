{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowUserToChangeOwnPassword",
      "Effect": "Allow",
      "Action": "iam:GetAccountPasswordPolicy",
      "Resource": "*"
    },
    {
      "Sid": "AllowUserToChangeOwnPasswordOnSelf",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ChangePassword"
      ],
      "Resource": "arn:aws:iam::*:user/${aws:username}"
    }
  ]
}