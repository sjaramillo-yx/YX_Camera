{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassIoTOtaServiceRoleDevTest",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/${STACK_BASE}-IoT-ota-service-role-dev",
        "arn:aws:iam::${ACCOUNT_ID}:role/${STACK_BASE}-IoT-ota-service-role-test"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "iot.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SignerReadForConsoleDropdowns",
      "Effect": "Allow",
      "Action": [
        "signer:ListSigningProfiles",
        "signer:GetSigningProfile",
        "signer:ListSigningPlatforms",
        "signer:GetSigningPlatform"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SignerJobsIfOtaUsesSigning",
      "Effect": "Allow",
      "Action": [
        "signer:StartSigningJob",
        "signer:DescribeSigningJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTCreateOtaUpdateDevTest",
      "Effect": "Allow",
      "Action": [
        "iot:CreateOTAUpdate",
        "iot:CreateJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OtaConsoleIntegrations",
      "Effect": "Allow",
      "Action": [
        "acm:ListCertificates",
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:AddTagsToCertificate",
        "signer:ListSigningProfiles",
        "signer:GetSigningProfile",
        "signer:StartSigningJob",
        "signer:ListSigningJobs",
        "signer:DescribeSigningJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSigningProfile",
      "Effect": "Allow",
      "Action": "signer:GetSigningProfile",
      "Resource": [
        "arn:aws:signer:${REGION}:${ACCOUNT_ID}:/signing-profiles/${STACK_BASE}-codesignprofile-dev",
        "arn:aws:signer:${REGION}:${ACCOUNT_ID}:/signing-profiles/${STACK_BASE}-codesignprofile-test"
      ]
    },
    {
      "Sid": "CreateSigningProfile",
      "Effect": "Allow",
      "Action": "signer:PutSigningProfile",
      "Resource": "*"
    }
  ]
}