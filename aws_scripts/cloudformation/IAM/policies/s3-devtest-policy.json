{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAllBucketsForConsole",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ListAndLocateCameraDataBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::*-dev-${ACCOUNT_ID}-${REGION}-camera-data",
        "arn:aws:s3:::*-test-${ACCOUNT_ID}-${REGION}-camera-data"
      ]
    },
    {
      "Sid": "RWObjectsInCameraDataBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:GetBucketVersioning",
        "s3:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:s3:::*-dev-${ACCOUNT_ID}-${REGION}-camera-data/*",
        "arn:aws:s3:::*-test-${ACCOUNT_ID}-${REGION}-camera-data/*"
      ]
    },
    {
      "Sid": "S3DeleteEnvCameraDataBucket",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::${LOWERCASE_STACK_BASE}-${ENV}-${ACCOUNT_ID}-${REGION}-camera-data"
    },
    {
      "Sid": "S3DeleteEnvCameraDataBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::${LOWERCASE_STACK_BASE}-${ENV}-${ACCOUNT_ID}-${REGION}-camera-data/*"
    }
  ]
}