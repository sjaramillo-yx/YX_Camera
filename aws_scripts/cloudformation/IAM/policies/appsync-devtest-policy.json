{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApisConsoleFriendly",
      "Effect": "Allow",
      "Action": [
        "appsync:ListGraphqlApis",
        "appsync:ListApiKeys",
        "appsync:ListDataSources",
        "appsync:ListFunctions",
        "appsync:ListResolvers",
        "appsync:ListTypes",
        "appsync:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSpecificAppSyncApi",
      "Effect": "Allow",
      "Action": [
        "appsync:GetGraphqlApi",
        "appsync:UpdateGraphqlApi",
        "appsync:DeleteGraphqlApi",
        "appsync:GetIntrospectionSchema",
        "appsync:SetIntrospectionSchema",
        "appsync:GetSchemaCreationStatus",
        "appsync:StartSchemaCreation",
        "appsync:GraphQL",
        "appsync:GetType",
        "appsync:CreateType",
        "appsync:UpdateType",
        "appsync:DeleteType",
        "appsync:GetDataSource",
        "appsync:CreateDataSource",
        "appsync:UpdateDataSource",
        "appsync:DeleteDataSource",
        "appsync:GetFunction",
        "appsync:CreateFunction",
        "appsync:UpdateFunction",
        "appsync:DeleteFunction",
        "appsync:GetResolver",
        "appsync:CreateResolver",
        "appsync:UpdateResolver",
        "appsync:DeleteResolver",
        "appsync:CreateApiKey",
        "appsync:DeleteApiKey",
        "appsync:UpdateApiKey",
        "appsync:TagResource",
        "appsync:UntagResource"
      ],
      "Resource": [
        "arn:aws:appsync:${REGION}:${ACCOUNT_ID}:apis/${STACK_BASE}-camera-db-api-dev",
        "arn:aws:appsync:${REGION}:${ACCOUNT_ID}:apis/${STACK_BASE}-camera-db-api-dev/*",
        "arn:aws:appsync:${REGION}:${ACCOUNT_ID}:apis/${STACK_BASE}-camera-db-api-test",
        "arn:aws:appsync:${REGION}:${ACCOUNT_ID}:apis/${STACK_BASE}-camera-db-api-test/*"
      ]
    },
    {
      "Sid": "PassOnlyAppSyncServiceRolesIfNeeded",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "appsync.amazonaws.com"
        }
      }
    }
  ]
}